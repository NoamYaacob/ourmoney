# Copy to .env and fill in real values. Never commit .env — see .gitignore.
#
# Supabase — introduced in Milestone 2. Unused in Milestone 1; declared here
# now so the expected shape is documented ahead of time.
# The ANON key only. The service role key must never appear in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
