# Copy to .env and fill in real values. Never commit .env — see .gitignore.
#
# Supabase — introduced in Milestone 2. Unused in Milestone 1; declared here
# now so the expected shape is documented ahead of time.
# The ANON key only. The service role key must never appear in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — crash reporting only, Milestone 11. See ADR-033. A DSN is not a
# secret (Sentry's SDK is designed to embed it in client bundles) — unlike
# the Supabase vars above, leaving this unset does not throw at startup;
# lib/monitoring/crashReporting.ts simply no-ops.
EXPO_PUBLIC_SENTRY_DSN=
